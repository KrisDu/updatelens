<Window x:Class="UpdateLens.Win.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="300" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F3F3F3" FontFamily="Segoe UI Variable Text, Segoe UI">
    <Border Background="White" CornerRadius="10" Margin="12" Padding="18" BorderBrush="#EDEBE9" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <CheckBox x:Name="LaunchBox" Content="Start with Windows (background check)" FontSize="13" Margin="0,0,0,10"/>
            <CheckBox x:Name="DailyBox" Content="Daily check at 09:30" FontSize="13" Margin="0,0,0,10"/>
            <TextBlock Text="Skipped and hidden apps persist across restarts." FontSize="12" Foreground="#616161" Margin="0,4,0,4"/>
            <Button Content="Reset skipped &amp; hidden" Padding="12,7" FontSize="12.5" Margin="0,4,0,12"
                    HorizontalAlignment="Left" Background="White" BorderBrush="#E1DFDD" BorderThickness="1" Cursor="Hand"
                    Click="Reset_Click"/>
            <Button Content="Close" Padding="20,8" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"
                    Background="#0067C0" Foreground="White" BorderThickness="0" Cursor="Hand" Click="Close_Click"/>
        </StackPanel>
    </Border>
</Window>
