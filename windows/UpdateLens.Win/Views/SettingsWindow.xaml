<Window x:Class="UpdateLens.Win.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="360" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource AppBgBrush}" Foreground="{DynamicResource TextFgBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Margin="12" Padding="18"
            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <TextBlock Text="Appearance" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <ComboBox x:Name="ThemeBox" Width="220" HorizontalAlignment="Left" FontSize="13" Padding="6,7" Margin="0,0,0,12"/>
            <TextBlock Text="Background" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <CheckBox x:Name="LaunchBox" Content="Start with Windows (background check)" FontSize="13" Margin="0,0,0,10"/>
            <CheckBox x:Name="DailyBox" Content="Daily check at 09:30" FontSize="13" Margin="0,0,0,10"/>
            <TextBlock Text="Skipped and hidden apps persist across restarts." FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,4"/>
            <Button Content="Reset skipped &amp; hidden" Padding="12,7" FontSize="12.5" Margin="0,4,0,12"
                    HorizontalAlignment="Left" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextFgBrush}"
                    BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" Cursor="Hand"
                    Click="Reset_Click"/>
            <Button Content="Close" Padding="20,8" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"
                    Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Cursor="Hand" Click="Close_Click"/>
        </StackPanel>
    </Border>
</Window>
