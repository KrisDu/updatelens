<Window x:Class="UpdateLens.Win.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Root"
        Title="UpdateLens" Height="640" Width="900"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <TextBox Width="240" Margin="4"
                     Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Search apps"/>
            <ComboBox Width="160" Margin="4"
                      ItemsSource="{Binding Filters}"
                      SelectedItem="{Binding Filter}"/>
            <Separator/>
            <Button Content="Refresh" Margin="4" Padding="12,4"
                    Command="{Binding RefreshCommand}"/>
            <Button Content="{Binding UpdateCount, StringFormat='Update All ({0})'}"
                    Margin="4" Padding="12,4"
                    Command="{Binding UpdateAllCommand}"/>
            <Button Content="Cancel" Margin="4" Padding="12,4"
                    Command="{Binding CancelCommand}"/>
        </ToolBar>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" Width="550"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding LastChecked, StringFormat='Last checked: {0}'}"/>
            </StatusBarItem>
        </StatusBar>

        <ListView ItemsSource="{Binding Filtered}" Margin="8"
                  HorizontalContentAlignment="Stretch" SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="6">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Width="520">
                                <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock FontSize="12" Foreground="Gray">
                                    <Run Text="{Binding Vendor, Mode=OneWay}"/><Run Text=" • "/><Run Text="{Binding Source, Mode=OneWay}"/><Run Text=" • "/><Run Text="{Binding VersionInstalled, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding StatusText, Mode=OneWay}" FontSize="12"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Update" Margin="4" Padding="12,4"
                                        IsEnabled="{Binding CanUpdate}"
                                        Command="{Binding DataContext.UpdateOneCommand, ElementName=Root}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="Skip" Margin="4" Padding="12,4"
                                        Command="{Binding DataContext.SkipCommand, ElementName=Root}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="Site" Margin="4" Padding="12,4" ToolTip="Open vendor site"
                                        IsEnabled="{Binding HasVendorUrl, Mode=OneWay}"
                                        Command="{Binding DataContext.OpenVendorCommand, ElementName=Root}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </DockPanel>
</Window>
