<Window x:Class="UpdateLens.Win.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Root"
        Title="UpdateLens" Height="660" Width="980"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Color x:Key="Accent">#0067C0</Color>
        <Color x:Key="AccentHover">#1975CC</Color>
        <Color x:Key="AccentPressed">#005A9E</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
        <SolidColorBrush x:Key="CardBrush" Color="White"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#616161"/>
        <SolidColorBrush x:Key="HairlineBrush" Color="#EDEBE9"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1B1A19"/>
            <Setter Property="BorderBrush" Value="#E1DFDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="MinWidth" Value="74"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Header bar -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="UpdateLens" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="Keep your apps current" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Refresh" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}"/>
                    <Button Content="{Binding UpdateCount, Mode=OneWay}" ContentStringFormat="Update all ({0})" Style="{StaticResource PrimaryButton}" Command="{Binding UpdateAllCommand}"/>
                    <Button Content="Cancel" Style="{StaticResource GhostButton}" Command="{Binding CancelCommand}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F3F3F3" BorderBrush="#E1DFDD" BorderThickness="1" CornerRadius="6" Padding="10,7" MinWidth="250">
                        <Grid>
                            <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent"
                                     ToolTip="Search apps" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="Search" Foreground="#9E9E9E" FontSize="13" Margin="2,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <ComboBox Width="170" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" Padding="6,7"
                              ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" ToolTip="Filter apps"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status footer -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="16,9">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Status, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="640"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding LastChecked, StringFormat='Last checked {0}', Mode=OneWay}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
            </DockPanel>
        </Border>

        <!-- App cards -->
        <ListView ItemsSource="{Binding Filtered, Mode=OneWay}" Margin="12,8" Background="Transparent" BorderThickness="0"
                  HorizontalContentAlignment="Stretch" SelectionMode="Single"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="0,4"/>
                    <Setter Property="Focusable" Value="False"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="14,12"
                            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Avatar -->
                            <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" Background="#E5F1FB" VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="{Binding Initials, Mode=OneWay}" Foreground="{StaticResource AccentBrush}"
                                           FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Info -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,6">
                                    <Run Text="{Binding Vendor, Mode=OneWay}"/><Run Text="  •  "/><Run Text="{Binding Source, Mode=OneWay}"/><Run Text="  •  "/><Run Text="{Binding VersionInstalled, Mode=OneWay}"/>
                                </TextBlock>
                                <Border x:Name="Pill" CornerRadius="9" Padding="9,4" HorizontalAlignment="Left"
                                        Background="#F0F0F0" BorderThickness="0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse x:Name="Dot" Width="8" Height="8" Fill="#8A8A8A" Margin="0,0,7,0"/>
                                        <TextBlock x:Name="PillText" Text="{Binding StatusText, Mode=OneWay}" FontSize="12" Foreground="#616161"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Actions -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Button Content="Update" Style="{StaticResource CardButton}"
                                        Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"
                                        IsEnabled="{Binding CanUpdate, Mode=OneWay}"
                                        Command="{Binding DataContext.UpdateOneCommand, ElementName=Root}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="Skip" Style="{StaticResource CardButton}"
                                        Background="White" BorderBrush="#E1DFDD" BorderThickness="1"
                                        Command="{Binding DataContext.SkipCommand, ElementName=Root}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="Site" Style="{StaticResource CardButton}" ToolTip="Open vendor site"
                                        Background="White" BorderBrush="#E1DFDD" BorderThickness="1"
                                        IsEnabled="{Binding HasVendorUrl, Mode=OneWay}"
                                        Command="{Binding DataContext.OpenVendorCommand, ElementName=Root}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <!-- Blue: update available / working -->
                        <DataTrigger Binding="{Binding StatusTone, Mode=OneWay}" Value="Blue">
                            <Setter TargetName="Pill" Property="Background" Value="#E5F1FB"/>
                            <Setter TargetName="Dot" Property="Fill" Value="#0067C0"/>
                            <Setter TargetName="PillText" Property="Foreground" Value="#0067C0"/>
                        </DataTrigger>
                        <!-- Green: current -->
                        <DataTrigger Binding="{Binding StatusTone, Mode=OneWay}" Value="Green">
                            <Setter TargetName="Pill" Property="Background" Value="#E6F4EA"/>
                            <Setter TargetName="Dot" Property="Fill" Value="#107C10"/>
                            <Setter TargetName="PillText" Property="Foreground" Value="#107C10"/>
                        </DataTrigger>
                        <!-- Red: failed -->
                        <DataTrigger Binding="{Binding StatusTone, Mode=OneWay}" Value="Red">
                            <Setter TargetName="Pill" Property="Background" Value="#FDE7E9"/>
                            <Setter TargetName="Dot" Property="Fill" Value="#C42B1C"/>
                            <Setter TargetName="PillText" Property="Foreground" Value="#C42B1C"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </DockPanel>
</Window>
